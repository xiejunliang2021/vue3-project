# ==========================================
# 前端独立服务器环境变量配置示例 (.env / .env.production)
# ==========================================

# 远端独立 Django 后端 API 根地址 (末尾不要带斜杠)
# 生产环境部署在不同服务器上时，请填入远端 Django 服务的公网域名或 HTTPS 地址：
VITE_API_BASE_URL=https://api.yourdomain.com

# 订阅链接的默认公共前缀 (若后端返回相对路径 /api/sub/<uuid>/ 时拼接使用)
VITE_SUB_BASE_URL=https://api.yourdomain.com

# 生产环境静态资源公共路径
VITE_PUBLIC_PATH=/
